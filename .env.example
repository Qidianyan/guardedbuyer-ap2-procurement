# Copy to .env (git-ignored) or point LLM_ENV_FILE at an existing file. Never commit real keys.
# Public OpenAI-compatible endpoint used for hosted deployments (no key here).
OPENAI_PUBLIC_BASE_URL=https://api.gavinchen.top/v1
# Optional override, e.g. a local rate-limiting proxy; takes precedence when set.
OPENAI_BASE_URL=
OPENAI_API_KEY=replace-me
LLM_MODEL=deepseek-v4.1-flash
# Optional PayPal sandbox credentials (developer.paypal.com -> Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
