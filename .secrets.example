# Copy to .secrets (git-ignored) and fill in your PayPal Developer SANDBOX app credentials:
# developer.paypal.com -> Apps & Credentials -> Sandbox -> your app -> Client ID / Secret
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Optional; sandbox is the default. Live hosts are refused.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
